# ============================================
# PaiRec4TigerLLM - 推荐服务镜像 (Go)
# ============================================
# 职责: 运行 pairec Go 推荐服务
# 特点: 多阶段构建，最终镜像极小 (~20-50MB)
# 要求: 无需 GPU，纯 CPU 服务
#
# 构建:
#   docker build -f docker/Dockerfile.pairec -t pairec-server:latest .
# 运行 (直接访问宿主机推理服务):
#   docker run --network host pairec-server:latest
# 运行 (Docker Compose):
#   docker compose up pairec
# ============================================

# ---------- 阶段 1: Builder ----------
FROM golang:1.24-alpine AS builder

ENV GOPROXY=off
ENV GOSUMDB=off
ENV GO111MODULE=on
ENV CGO_ENABLED=0

WORKDIR /build

# 复制 go.mod/go.sum 与 vendored 依赖，保持离线构建
COPY go.mod go.sum ./
COPY vendor/ ./vendor/

# 复制 services 源码
COPY services/ ./services/

# 编译静态二进制
RUN go build -mod=vendor -ldflags="-s -w" -o pairec-server ./services/main.go

# ---------- 阶段 2: Runtime ----------
FROM alpine:3.19

WORKDIR /app

# 从 builder 复制编译好的二进制
COPY --from=builder /build/pairec-server /app/pairec-server

# 复制配置模板（数据文件通过 volume 挂载）
COPY configs/ /app/configs/
COPY docker/entrypoint-pairec.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# 环境变量
ENV CONFIG_PATH=/app/configs/pairec_config.json
ENV INFERENCE_HOST=localhost
ENV INFERENCE_PORT=18000
ENV PAIREC_PORT=18080

EXPOSE 18080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://localhost:18080/ping || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
