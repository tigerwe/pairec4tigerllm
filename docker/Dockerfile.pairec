# ============================================
# PaiRec4TigerLLM - 推荐服务镜像 (Go)
# ============================================
# 职责: 运行 pairec Go 推荐服务
# 特点: 多阶段构建，最终镜像极小 (~20-50MB)
# 要求: 无需 GPU，纯 CPU 服务
#
# 构建命令:
#   docker build -f docker/Dockerfile.pairec -t pairec-server:latest .
# ============================================

# ---------- 阶段 1: Builder ----------
FROM golang:1.24-alpine AS builder

ENV GOPROXY=https://goproxy.cn,direct
ENV GO111MODULE=on
ENV CGO_ENABLED=0

WORKDIR /build

# 先复制 go.mod / go.sum，利用 Docker 缓存层
COPY services/go.mod services/go.sum ./
RUN go mod download

# 再复制源代码
COPY services/ ./

# 编译静态二进制（无 CGO，可在 alpine 运行）
RUN go build -ldflags="-s -w" -o pairec-server main.go

# ---------- 阶段 2: Runtime ----------
FROM alpine:3.19

# 安装 ca-certificates（HTTPS 调用推理服务需要）和 curl（健康检查）
RUN apk add --no-cache ca-certificates curl

WORKDIR /app

# 从 builder 阶段复制编译好的二进制
COPY --from=builder /build/pairec-server /app/pairec-server

# 复制配置文件和数据（也可以通过 volume 挂载）
COPY configs/ /app/configs/
COPY data/ /app/data/

# 复制启动脚本
COPY docker/entrypoint-pairec.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# 运行时环境变量
ENV CONFIG_PATH=/app/configs/pairec_config.json
ENV PORT=8080
ENV INFERENCE_URL=http://inference:8000

EXPOSE 8080

# 健康检查
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:8080/health || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
