# ============================================
# PaiRec4TigerLLM - Qwen3 训练镜像
# ============================================
# 构建: docker build -f docker/Dockerfile.train -t pairec-train:latest .
# 导出: docker save pairec-train:latest | gzip > /home/zcx/pairec-train.tar.gz
# 导入: gunzip -c /home/zcx/pairec-train.tar.gz | docker load
# ============================================

FROM nvidia/cuda:12.4.0-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# ---------- 系统依赖 ----------
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    python3-dev \
    git \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.10 1

# ---------- PyTorch + 核心依赖 ----------
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel && \
    pip3 install --no-cache-dir \
        torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cu124

# ---------- Qwen3 训练依赖 ----------
RUN pip3 install --no-cache-dir \
    transformers>=4.51.0 \
    peft>=0.14.0 \
    accelerate>=0.33.0 \
    bitsandbytes>=0.44.0 \
    sentencepiece \
    numpy \
    pandas \
    scikit-learn \
    flask \
    requests \
    werkzeug \
    tqdm \
    tensorboard \
    pyyaml \
    psutil

# ---------- 运行时 ----------
WORKDIR /workspace
ENV PYTHONPATH=/workspace
ENV HF_HUB_CACHE=/workspace/.cache/huggingface

CMD ["/bin/bash"]
