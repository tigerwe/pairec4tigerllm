{
  "RunMode": "daily",
  "ListenConf": {
    "HttpAddr": "0.0.0.0",
    "HttpPort": 18080
  },
  "PrometheusConfig": {
    "Enable": true,
    "Subsystem": "pairec_brpc_wrapper_full"
  },
  "SceneConfs": {
    "home_feed": {
      "default": {
        "RecallNames": ["multi_recall_2_48"]
      }
    }
  },
  "SortNames": {
    "home_feed": ["deepfm_rank_sort"]
  },
  "RecallConfs": [
    {
      "Name": "generative_recall",
      "RecallType": "GenerativeRecall",
      "RecallCount": 50,
      "CacheTime": 0,
      "RecallAlgo": "{\"protocol\":\"brpc\",\"brpc_endpoint\":\"__WRAPPER_ENDPOINT__\",\"brpc_service_name\":\"pairec.inference.RecommendService\",\"brpc_fallback_to_http\":false,\"brpc_payload_bytes\":__BUSINESS_PAYLOAD_BYTES__,\"brpc_burst_enabled\":true,\"brpc_burst_concurrency\":__BURST_CONCURRENCY__,\"brpc_burst_pool_size\":__BURST_POOL_SIZE__,\"brpc_burst_active_connections\":__BURST_ACTIVE_CONNECTIONS__,\"brpc_burst_cpu_shards\":__BURST_CPU_SHARDS__,\"brpc_burst_payload_bytes\":__BURST_PAYLOAD_BYTES__,\"brpc_burst_preconnect\":true,\"brpc_burst_pressure_timeout_ms\":5000,\"timeout_ms\":5000,\"max_retries\":0,\"topk\":50,\"temperature\":1.0,\"beam_width\":1,\"history_from\":\"user_feature\",\"history_feature_name\":\"click_history\",\"history_delimiter\":\",\",\"history_max_length\":20,\"feature_source\":\"file\"}"
    },
    {
      "Name": "milvus_recall",
      "RecallType": "MilvusRecall",
      "RecallCount": 50,
      "CacheTime": 0,
      "ItemType": "video",
      "RecallAlgo": "{\"protocol\":\"brpc\",\"brpc_endpoint\":\"__VECTOR_ENDPOINT__\",\"brpc_service_name\":\"pairec.pipeline.VectorRecallService\",\"timeout_ms\":300,\"topk\":50}"
    },
    {
      "Name": "multi_recall_2_48",
      "RecallType": "QuotaMultiRecall",
      "RecallCount": 50,
      "CacheTime": 0,
      "RecallAlgo": "{\"primary_recall_name\":\"generative_recall\",\"secondary_recall_name\":\"milvus_recall\",\"primary_minimum\":1,\"primary_quota\":2,\"total_limit\":50}"
    }
  ],
  "UserDefineConfs": {
    "DeepFMRankSorts": [
      {
        "name": "deepfm_rank_sort",
        "protocol": "brpc",
        "brpc_endpoint": "__RANK_ENDPOINT__",
        "brpc_service_name": "pairec.pipeline.DeepFMRankService",
        "timeout_ms": __RANK_TIMEOUT_MS__,
        "brpc_payload_bytes": __RANK_BUSINESS_PAYLOAD_BYTES__,
        "brpc_burst_enabled": __RANK_BURST_ENABLED__,
        "brpc_burst_concurrency": __RANK_BURST_CONCURRENCY__,
        "brpc_burst_pool_size": __RANK_BURST_POOL_SIZE__,
        "brpc_burst_payload_bytes": __RANK_BURST_PAYLOAD_BYTES__,
        "brpc_burst_preconnect": __RANK_BURST_PRECONNECT__,
        "brpc_burst_pressure_timeout_ms": __RANK_BURST_PRESSURE_TIMEOUT_MS__,
        "expected_candidates": 50,
        "required_model_role": "__DEEPFM_MODEL_ROLE__"
      }
    ],
    "RerankConfs": [
      {
        "name": "source_quota_tail",
        "enabled": true,
        "generative_source": "generative_recall",
        "vector_source": "milvus_recall",
        "expected_candidates": 50,
        "minimum_generative": 1,
        "max_generative": 2,
        "placement": "tail",
        "fail_closed": true
      }
    ]
  }
}
