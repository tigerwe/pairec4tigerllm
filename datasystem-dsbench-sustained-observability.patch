+int64_t SteadyNowNs()
+{
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch())
+        .count();
+}
+
+void UpdateMaximum(std::atomic<uint64_t> &maximum, uint64_t value)
+{
+    uint64_t observed = maximum.load(std::memory_order_relaxed);
+    while (observed < value
+           && !maximum.compare_exchange_weak(observed, value, std::memory_order_relaxed)) {
+    }
+}
+
+Status WriteTextFile(const std::string &path, const std::string &content)
+{
+    if (path.empty()) {
+        return Status::OK();
+    }
+    std::ofstream output(path, std::ios::out | std::ios::trunc);
+    CHECK_FAIL_RETURN_STATUS(output.is_open(), K_RUNTIME_ERROR, "Cannot open state file: " + path);
+    output << content << std::endl;
+    return Status::OK();
+}
+
+void WaitForStartFile(const std::string &path)
+{
+    while (!path.empty()) {
+        std::ifstream input(path);
+        if (input.good()) {
+            return;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+}
+
+void WriteStats(const KVArgs &args, bool final)
+{
+    if (args.statsFile.empty()) {
+        return;
+    }
+    int64_t const nowNs = SteadyNowNs();
+    int64_t const startedNs = gLoadStartedNs.load(std::memory_order_relaxed);
+    double const elapsedSeconds = std::max(0.000001, static_cast<double>(nowNs - startedNs) / 1.0e9);
+    uint64_t const calls = gCalls.load(std::memory_order_relaxed);
+    uint64_t const success = gSuccess.load(std::memory_order_relaxed);
+    uint64_t const errors = gErrors.load(std::memory_order_relaxed);
+    uint64_t const bytes = gBytes.load(std::memory_order_relaxed);
+    uint64_t const totalLatencyUs = gTotalLatencyUs.load(std::memory_order_relaxed);
+    double const qps = static_cast<double>(success) / elapsedSeconds;
+    double const gbps = static_cast<double>(bytes) * 8.0 / elapsedSeconds / 1.0e9;
+    double const avgMs = calls == 0 ? 0.0 : static_cast<double>(totalLatencyUs) / calls / 1000.0;
+
+    std::ofstream output(args.statsFile, std::ios::out | std::ios::app);
+    if (!output.is_open()) {
+        return;
+    }
+    output << "{\"event\":\"dsbench_pressure_stats\",\"action\":\"" << args.action << "\","
+           << "\"final\":" << (final ? "true" : "false") << ","
+           << "\"elapsed_s\":" << elapsedSeconds << ","
+           << "\"ready_workers\":" << gReadyWorkers.load(std::memory_order_relaxed) << ","
+           << "\"calls\":" << calls << ","
+           << "\"success\":" << success << ","
+           << "\"errors\":" << errors << ","
+           << "\"bytes\":" << bytes << ","
+           << "\"qps\":" << qps << ","
+           << "\"gbps\":" << gbps << ","
+           << "\"avg_ms\":" << avgMs << ","
+           << "\"current_inflight\":" << gActiveCalls.load(std::memory_order_relaxed) << ","
+           << "\"max_inflight\":" << gMaxInflight.load(std::memory_order_relaxed) << "}"
+           << std::endl;
+}
+
+void MaybeWriteStats(const KVArgs &args, bool final)
+{
+    if (args.statsFile.empty()) {
+        return;
+    }
+    int64_t const nowNs = SteadyNowNs();
+    if (!final) {
+        int64_t nextNs = gNextReportNs.load(std::memory_order_relaxed);
+        int64_t const intervalNs = static_cast<int64_t>(args.reportIntervalMs) * 1000000;
+        if (nowNs < nextNs
+            || !gNextReportNs.compare_exchange_strong(nextNs, nowNs + intervalNs, std::memory_order_relaxed)) {
+            return;
+        }
+    }
+    WriteStats(args, final);
+}
+
+}  // namespace
 
