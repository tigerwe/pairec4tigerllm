load("@rules_proto//proto:defs.bzl", "proto_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_proto_library")

COPTS = [
    "-std=c++17",
    # --define brpc_with_urma=true selects the URMA-enabled bRPC library but
    # does not propagate this C++ preprocessor symbol to reverse dependencies.
    "-DBRPC_WITH_URMA",
    "-D__STDC_FORMAT_MACROS",
    "-D__STDC_LIMIT_MACROS",
    "-D__STDC_CONSTANT_MACROS",
    "-D_GNU_SOURCE",
    "-fPIC",
    "-Wno-unused-parameter",
    "-fno-omit-frame-pointer",
]

proto_library(
    name = "recommend_proto",
    srcs = ["recommend.proto"],
)

cc_proto_library(
    name = "recommend_cc_proto",
    deps = [":recommend_proto"],
)

proto_library(
    name = "pipeline_service_proto",
    srcs = ["pipeline_service.proto"],
)

cc_proto_library(
    name = "pipeline_service_cc_proto",
    deps = [":pipeline_service_proto"],
)

cc_binary(
    name = "minimal_recommend_server",
    srcs = [
        "minimal_recommend_server.cpp",
        "payload_integrity.h",
        "ubsocket_trace_key_workaround.h",
    ],
    copts = COPTS,
    deps = [
        ":recommend_cc_proto",
        "//:brpc",
    ],
)

cc_binary(
    name = "brpc_post_rank_hop",
    srcs = [
        "brpc_post_rank_hop.cpp",
        "post_rank_hop_burst.cpp",
        "post_rank_hop_burst.h",
        "ubsocket_trace_key_workaround.h",
    ],
    copts = COPTS,
    deps = [
        ":pipeline_service_cc_proto",
        "//:brpc",
    ],
)

cc_binary(
    name = "post_rank_qualification_client",
    srcs = ["post_rank_qualification_client.cpp"],
    copts = COPTS,
    deps = [
        ":pipeline_service_cc_proto",
        "//:brpc",
    ],
)

cc_binary(
    name = "minimal_recommend_client",
    srcs = [
        "minimal_recommend_client.cpp",
        "payload_integrity.h",
        "ubsocket_trace_key_workaround.h",
    ],
    copts = COPTS,
    deps = [
        ":recommend_cc_proto",
        "//:brpc",
    ],
)
