+
+char const* dataSystemEnv(char const* name)
+{
+    auto const* value = std::getenv(name);
+    return value != nullptr && value[0] != '\0' ? value : nullptr;
+}
+
+std::string dataSystemEnvString(char const* name, char const* defaultValue = "")
+{
+    auto const* value = dataSystemEnv(name);
+    return value != nullptr ? std::string(value) : std::string(defaultValue);
+}
+
+std::string normalizedDataSystemEnv(char const* name)
+{
+    auto value = dataSystemEnvString(name);
+    std::transform(value.begin(), value.end(), value.begin(),
+        [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return value;
+}
+
+int32_t dataSystemEnvInt(char const* name, int32_t defaultValue)
+{
+    auto const* value = dataSystemEnv(name);
+    if (value == nullptr)
+    {
+        return defaultValue;
+    }
+    try
+    {
+        return std::stoi(value);
+    }
+    catch (std::exception const& e)
+    {
+        TLLM_LOG_WARNING(
+            "[TensorRT-LLM][Datasystem] Ignore invalid integer env %s=%s: %s", name, value, e.what());
+        return defaultValue;
+    }
+}
+
+uint64_t dataSystemEnvUInt64(char const* name, uint64_t defaultValue)
+{
+    auto const* value = dataSystemEnv(name);
+    if (value == nullptr)
+    {
+        return defaultValue;
+    }
+    try
+    {
+        return std::stoull(value);
+    }
+    catch (std::exception const& e)
+    {
+        TLLM_LOG_WARNING(
+            "[TensorRT-LLM][Datasystem] Ignore invalid uint64 env %s=%s: %s", name, value, e.what());
+        return defaultValue;
+    }
+}
+
+bool dataSystemEnvBool(char const* name, bool defaultValue)
+{
+    auto value = normalizedDataSystemEnv(name);
+    if (value.empty())
+    {
+        return defaultValue;
+    }
+    if (value == "1" || value == "true" || value == "yes" || value == "on")
+    {
+        return true;
+    }
+    if (value == "0" || value == "false" || value == "no" || value == "off")
+    {
+        return false;
+    }
+    TLLM_LOG_WARNING("[TensorRT-LLM][Datasystem] Ignore invalid bool env %s=%s", name, value.c_str());
+    return defaultValue;
+}
+
+datasystem::ServiceAffinityPolicy dataSystemAffinityPolicy()
+{
+    auto value = normalizedDataSystemEnv("DATASYSTEM_AFFINITY_POLICY");
+    if (value.empty() || value == "preferred_same_node" || value == "preferred")
+    {
+        return datasystem::ServiceAffinityPolicy::PREFERRED_SAME_NODE;
+    }
+    if (value == "required_same_node" || value == "required")
+    {
+        return datasystem::ServiceAffinityPolicy::REQUIRED_SAME_NODE;
+    }
+    if (value == "random")
+    {
+        return datasystem::ServiceAffinityPolicy::RANDOM;
+    }
+    TLLM_LOG_WARNING(
+        "[TensorRT-LLM][Datasystem] Ignore invalid DATASYSTEM_AFFINITY_POLICY=%s", value.c_str());
+    return datasystem::ServiceAffinityPolicy::PREFERRED_SAME_NODE;
+}
+
+char const* dataSystemAffinityPolicyName(datasystem::ServiceAffinityPolicy policy)
+{
+    switch (policy)
+    {
+    case datasystem::ServiceAffinityPolicy::REQUIRED_SAME_NODE: return "REQUIRED_SAME_NODE";
+    case datasystem::ServiceAffinityPolicy::RANDOM: return "RANDOM";
+    case datasystem::ServiceAffinityPolicy::PREFERRED_SAME_NODE:
+    default: return "PREFERRED_SAME_NODE";
+    }
+}
+
+datasystem::ConnectOptions makeDataSystemConnectOptions(char const* role, char const* fallbackHost)
+{
+    datasystem::ConnectOptions connOpts;
+    connOpts.SetAkSkAuth("", "", "");
+    connOpts.connectTimeoutMs = dataSystemEnvInt("DATASYSTEM_CONNECT_TIMEOUT_MS", 60000);
+    connOpts.requestTimeoutMs = dataSystemEnvInt("DATASYSTEM_REQUEST_TIMEOUT_MS", 10000);
+    connOpts.enableExclusiveConnection = dataSystemEnvBool("DATASYSTEM_ENABLE_EXCLUSIVE_CONNECTION", false);
+    connOpts.enableRemoteH2D = dataSystemEnvBool("DATASYSTEM_ENABLE_REMOTE_H2D", false);
+    connOpts.fastTransportMemSize = dataSystemEnvUInt64("DATASYSTEM_FAST_TRANSPORT_MEM_SIZE", connOpts.fastTransportMemSize);
+    connOpts.deviceId = dataSystemEnvString("DATASYSTEM_DEVICE_ID");
+
+    auto const etcdAddress = dataSystemEnvString("DATASYSTEM_ETCD_ADDRESS");
+    if (!etcdAddress.empty())
+    {
+        datasystem::ServiceDiscoveryOptions sdOpts;
+        sdOpts.etcdAddress = etcdAddress;
+        sdOpts.clusterName = dataSystemEnvString("DATASYSTEM_CLUSTER_NAME");
+        sdOpts.hostIdEnvName = dataSystemEnvString("DATASYSTEM_HOST_ID_ENV_NAME");
+        sdOpts.username = dataSystemEnvString("DATASYSTEM_ETCD_USERNAME");
+        sdOpts.password = dataSystemEnvString("DATASYSTEM_ETCD_PASSWORD");
+        sdOpts.affinityPolicy = dataSystemAffinityPolicy();
+        connOpts.serviceDiscovery = std::make_shared<datasystem::ServiceDiscovery>(sdOpts);
+        connOpts.enableCrossNodeConnection = dataSystemEnvBool("DATASYSTEM_ENABLE_CROSS_NODE_CONNECTION", true);
+
+        TLLM_LOG_INFO("[TensorRT-LLM][Datasystem] Init KvCache %s DataSystem with ServiceDiscovery. etcd=%s cluster=%s host_id_env=%s affinity=%s cross_node=%d fast_transport_mem_size=%llu.",
+            role, sdOpts.etcdAddress.c_str(), sdOpts.clusterName.c_str(), sdOpts.hostIdEnvName.c_str(),
+            dataSystemAffinityPolicyName(sdOpts.affinityPolicy), connOpts.enableCrossNodeConnection ? 1 : 0,
+            static_cast<unsigned long long>(connOpts.fastTransportMemSize));
+        return connOpts;
+    }
+
+    connOpts.host = dataSystemEnvString("DATASYSTEM_HOST", fallbackHost);
+    connOpts.port = dataSystemEnvInt("DATASYSTEM_PORT", 31501);
+    connOpts.enableCrossNodeConnection = dataSystemEnvBool("DATASYSTEM_ENABLE_CROSS_NODE_CONNECTION", false);
+    TLLM_LOG_INFO("[TensorRT-LLM][Datasystem] Init KvCache %s DataSystem with host endpoint. host=%s port=%d cross_node=%d.",
+        role, connOpts.host.c_str(), connOpts.port, connOpts.enableCrossNodeConnection ? 1 : 0);
+    return connOpts;
+}
+
+} // namespace
+
